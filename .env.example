TMDB_API_KEY=your_tmdb_read_access_token_here

# Optional comma-separated extra CORS origins. localhost:5173, 127.0.0.1:5173,
# and the live Workers frontend are always allowed. Do not set "*".
# CORS_ORIGINS=https://preview.example.com

# Local dev (default): SQLite file in project root
DATABASE_URL=sqlite:///database.db

# Optional: Neon dev branch (use sslmode=require in the connection string)
# DATABASE_URL=postgresql://user:pass@host/dbname?sslmode=require
# (Neon / FastAPI Cloud URLs are rewritten to use the psycopg driver automatically)

# Production: set DATABASE_URL via FastAPI Cloud → Integrations → Neon
# (injected automatically; do not commit secrets)
